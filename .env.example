# YuriVerse Environment Configuration
# All primary APIs work 100% out of the box with NO keys required!

# ---------------------------------------------------------------------------
# 1. KINDE AUTHENTICATION (Optional: Sign In, Sign Up, User Profiles & Admin)
# ---------------------------------------------------------------------------
# Get your credentials at https://yuriverse.kinde.com
VITE_KINDE_CLIENT_ID=488dc9038b0d4282977f5e6e7b3b3d0b
VITE_KINDE_DOMAIN=https://yuriverse.kinde.com
# Optional custom redirect override (defaults to current window.location.origin)
VITE_KINDE_REDIRECT_URI=
VITE_KINDE_LOGOUT_URI=

# ---------------------------------------------------------------------------
# 2. CORE APIS (No API Key Required - Ready Out of the Box)
# ---------------------------------------------------------------------------
# - AniList (GraphQL): Public API for Anime & Manga metadata.
# - Jikan (REST): Public MyAnimeList API for top lists, ratings & relations.
# - MangaDex (REST): Public API for manga chapter lists & scanlations.

# ---------------------------------------------------------------------------
# 3. TMDB (Optional - Movies, TV Dramas & Live-Action GL)
# ---------------------------------------------------------------------------
# A fallback demo key is already included, but you can provide
# your own free API key from https://www.themoviedb.org/settings/api:
VITE_TMDB_API_KEY=

# ---------------------------------------------------------------------------
# 4. FIRECRAWL (Optional - Web Scraping / Web Novels)
# ---------------------------------------------------------------------------
VITE_FIRECRAWL_API_KEY=

# ---------------------------------------------------------------------------
# 5. APP CONFIGURATION
# ---------------------------------------------------------------------------
VITE_APP_NAME="YuriVerse"
