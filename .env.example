# YuriOrbit Environment Configuration
# All primary APIs work 100% out of the box with NO keys required!

# ---------------------------------------------------------------------------
# 1. SUPABASE (Authentication, synced libraries)
# ---------------------------------------------------------------------------
# Optional. Without these the site still builds and runs: sign-in is disabled
# and user libraries are stored locally in the browser.
# On Cloudflare Pages, set these as Build environment variables (they are baked
# into the client bundle at build time, so redeploy after changing them).
# The anon key is public by design; row-level security protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Admin Authorization: Comma-separated list of emails with Admin privileges
# Example: VITE_ADMIN_EMAILS=owner@example.com,developer@example.com
VITE_ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# 2. CORE APIS (No API Key Required - Ready Out of the Box)
# ---------------------------------------------------------------------------
# - AniList (GraphQL): Public API for Anime & Manga metadata.
# - Jikan (REST): Public MyAnimeList API for top lists, ratings & relations.
# - MangaDex (REST): Public API for manga chapter lists & scanlations.

# ---------------------------------------------------------------------------
# 3. TMDB (Optional - Movies, TV Dramas & Live-Action GL)
# ---------------------------------------------------------------------------
VITE_TMDB_API_KEY=

# ---------------------------------------------------------------------------
# 4. FIRECRAWL (Optional - Web Scraping / Web Novels)
# ---------------------------------------------------------------------------
VITE_FIRECRAWL_API_KEY=

# ---------------------------------------------------------------------------
# 5. APP CONFIGURATION
# ---------------------------------------------------------------------------
VITE_APP_NAME="YuriOrbit"
